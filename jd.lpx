#!name=京东去广告
#!desc=移除京东开屏广告，精简我的页面产品推广。
#!author=RuCu6, Maasea, luoxx
#!category=luoxx
#!tag=去广告
#!icon=https://www.jd.com/favicon.ico
#!homepage=https://github.com/luoxmc/loon/blob/main/README.md

[Rule]
DOMAIN,ads-img-x.jd.com,REJECT
DOMAIN,ads-video-x.jd.com,REJECT
URL-REGEX,^http://\w{32}\.jddebug\.com/diagnose\?,REJECT
URL-REGEX,^https://m\.360buyimg\.com/mobilecms/s1125x2436_jfs/?,REJECT

[Rewrite]
response if ${url} ~= /^https:\/\/api\.m\.jd\.com\/client\.action\?functionId=(searchBoxWord|stationPullService|uniformRecommend[06])/ then response.body.mock("{}", "application/json", 200)

[Script]
http-response ^https://api\.m\.jd\.com/client\.action script-path=https://raw.githubusercontent.com/luoxmc/loon/refs/heads/main/surge/Scripts/jd_ads_remove.js, requires-body=true, max-size=2097152, tag=移除京东广告

[MITM]
hostname = %APPEND% api.m.jd.com, m.360buyimg.com